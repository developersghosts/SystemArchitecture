{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=ServiceDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "InitializeOnStartup": false
  },
  "JWT": {
    "Key": "",
    "Issuer": "ServicesA",
    "Audience": "ServicesA",
    "DurationInMinutes": 120
  },
  "EmailSettings": {
    "SmtpServer": "",
    "Port": 587,
    "SenderName": "System Architecture",
    "SenderEmail": "",
    "Username": "",
    "Password": "",
    "ResetPasswordUrl": "http://localhost:4200/auth/reset-password",
    "PickupDirectory": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/servicesa-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "AllowedHosts": "*"
}
